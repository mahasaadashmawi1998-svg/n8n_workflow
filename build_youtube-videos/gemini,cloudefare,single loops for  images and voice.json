        "jsCode": "const scene = $('Loop Images').item.json;\nconst cfg = $('Config1').first().json;\nconst edited = String($json['Image prompt (leave empty to keep)'] || '').trim();\nconst base = edited || scene.image_prompt;\nconst n = String(scene.scene).padStart(2, '0');\nreturn { json: {\n  ...scene,\n  image_prompt_final: base + '. Main character: ' + scene.character + '. Style: ' + cfg.style,\n  image_path: cfg.base_dir + '/' + $execution.id + '_scene_' + n + '_image.jpg'\n} };"
