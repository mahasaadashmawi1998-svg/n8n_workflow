        "jsCode": "const items = $input.all().map(i => i.json).sort((a, b) => a.scene - b.scene);\nconst cfg = $('Config1').first().json;\nconst ff = '\"' + cfg.ffmpeg_path + '\"';\nconst out = cfg.base_dir + '/' + $execution.id + '_final.mp4';\nlet cmd;\nif (items.length === 1) {\n  cmd = ff + ' -y -i \"' + items[0].clip_path + '\" -c copy \"' + out + '\"';\n} else {\n  const inputs = items.map(s => '-i \"' + s.clip_path + '\"').join(' ');\n  const maps = items.map((s, i) => '[' + i + ':v][' + i + ':a]').join('');\n  cmd = ff + ' -y ' + inputs + ' -filter_complex \"' + maps + 'concat=n=' + items.length + ':v=1:a=1[v][a]\" -map \"[v]\" -map \"[a]\" -c:v libx264 -pix_fmt yuv420p -c:a aac \"' + out + '\"';\n}\nreturn [{ json: { join_command: cmd, final_path: out, count: items.length } }];"
      },
