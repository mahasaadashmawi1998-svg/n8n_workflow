    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.candidates[0].content.parts[0].text;\nconst data = JSON.parse(raw.replace(/```json|```/g, '').trim());\nreturn data.scenes.map((s, i) => ({ json: {\n  scene: i + 1,\n  total: data.scenes.length,\n  title: data.title,\n  character: data.character_description || '',\n  script: s.script,\n  image_prompt: s.image_prompt,\n  on_screen_text: s.on_screen_text\n} }));"
      },
