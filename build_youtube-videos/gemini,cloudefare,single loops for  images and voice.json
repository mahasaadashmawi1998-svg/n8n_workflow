    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const scene = $('Apply Script1').item.json;\nconst cfg = $('Config1').first().json;\nlet buf;\nconst keys = Object.keys($binary || {});\nif (keys.length) {\n  buf = await this.helpers.getBinaryDataBuffer($itemIndex, keys[0]);\n  if (buf.slice(0, 1).toString('latin1') === '{') {\n    const j = JSON.parse(buf.toString('utf8'));\n    const b64 = (j.result && j.result.audio) || j.audio;\n    if (!b64) throw new Error('JSON without audio: ' + buf.toString('utf8').slice(0, 300));\n    buf = Buffer.from(b64, 'base64');\n  }\n} else {\n  const b64 = ($json.result && $json.result.audio) || $json.audio;\n  if (!b64) throw new Error('No audio in JSON or binary. Input: ' + JSON.stringify($json));\n  buf = Buffer.from(b64, 'base64');\n}\nconst ext = buf.slice(0, 4).toString('latin1') === 'RIFF' ? 'wav' : 'mp3';\nconst n = String(scene.scene).padStart(2, '0');\nconst run = $execution.id;\nconst srcName = run + '_scene_' + n + '_audio_src.' + ext;\nconst bin = await this.helpers.prepareBinaryData(buf, srcName, ext === 'wav' ? 'audio/wav' : 'audio/mpeg');\nreturn { json: {\n  ...scene,\n  audio_bytes: buf.length,\n  src_path: cfg.base_dir + '/' + srcName,\n  mp3_path: cfg.base_dir + '/' + run + '_scene_' + n + '_audio.mp3',\n  clip_path: cfg.base_dir + '/' + run + '_scene_' + n + '_clip.mp4'\n}, binary: { audio: bin } };"
      },
