        2480,
        1120
      ],
      "id": "e47cd086-86dc-47ad-ad3b-374db6dbe241"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst out = [];\nfor (const it of items) {\n  const n = String(it.json.scene).padStart(2, '0');\n  for (const kind of ['image', 'audio']) {\n    const name = 'scene_' + n + '_' + kind;\n    out.push({\n      json: { scene: it.json.scene, kind, asset_name: name, name_base64: Buffer.from(name).toString('base64') },\n      binary: { data: it.binary[kind] }\n    });\n  }\n}\nreturn out;"
      },
