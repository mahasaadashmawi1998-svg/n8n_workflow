    {
      "parameters": {
        "jsCode": "const map = {};\nfor (const it of $input.all()) {\n  const job = it.json.job;\n  if (job.status !== 'success') throw new Error('Canva upload failed: ' + JSON.stringify(job.error || job));\n  const m = /scene_(\\d+)_(image|audio)/.exec(job.asset.name);\n  if (!m) continue;\n  const n = parseInt(m[1], 10);\n  map[n] = map[n] || { scene: n };\n  map[n][m[2] + '_asset_id'] = job.asset.id;\n}\nconst info = $('Apply Edits & Split Scenes1').all().map(i => i.json);\nconst scenes = Object.values(map).sort((a, b) => a.scene - b.scene).map(s => ({\n  ...s, caption: info[s.scene - 1].on_screen_text, script: info[s.scene - 1].script\n}));\nreturn [{ json: { title: info[0].title, scenes } }];"
      },
