    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-3.5-flash-lite:generateContent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-goog-api-key",
              "value": "={{ $('Config1').first().json.gemini_api_key }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  contents: [{ parts: [{ text: \"Write an English narration script for a short vertical video about: \" + $json.topic + \". Use exactly \" + $json.scene_count + \" scenes. Return JSON only in this shape: {\\\"title\\\": \\\"string\\\", \\\"character_description\\\": \\\"one sentence describing the main character or visual motif so every image looks consistent\\\", \\\"scenes\\\": [{\\\"script\\\": \\\"1-2 sentences of narration\\\", \\\"image_prompt\\\": \\\"detailed description of the scene to illustrate\\\", \\\"on_screen_text\\\": \\\"max 6 words\\\"}]}\" }] }],\n  generationConfig: { responseMimeType: \"application/json\" }\n}) }}",
        "options": {}
      },
      "name": "Gemini - Write Script1",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1152,
        1120
      ],
      "id": "17ee2316-6bb3-4b1d-8008-943206244b91",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.candidates[0].content.parts[0].text;\nconst data = JSON.parse(raw.replace(/```json|```/g, '').trim());\nconst esc = s => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nconst pretty = JSON.stringify(data, null, 2);\nconst html = '<p>Review the generated script below. To change anything, copy the JSON, edit it, and paste it into the box. Leave the box empty to approve it as is.</p><pre style=\"white-space:pre-wrap;text-align:left\">' + esc(pretty) + '</pre>';\nreturn [{ json: { data, html } }];"
      },
      "name": "Format Script for Edit1",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1360,
        1120
      ],
      "id": "2e652ec9-40b5-4657-a575-5f85bdba1926"
    },
    {
      "parameters": {
        "formFields": {
          "values": [
            {
              "fieldLabel": "Edited script JSON (optional)",
              "fieldType": "textarea",
              "placeholder": "Paste edited JSON here, or leave empty to approve"
            }
          ]
        },
        "options": {
          "formTitle": "Review your script",
          "formDescription": "={{ $json.html }}",
          "buttonLabel": "Approve & generate scenes"
        }
      },
      "name": "Review & Edit Script1",
      "type": "n8n-nodes-base.form",
      "typeVersion": 2.3,
      "position": [
        1584,
        1120
      ],
      "id": "0f0512a7-8106-43ea-8614-50aaa17d12c7",
      "webhookId": "e1c5625a-8457-4fc2-b21d-9449888427f2"
    },
    {
      "parameters": {
        "jsCode": "const original = $('Format Script for Edit1').first().json.data;\nconst edited = String($json['Edited script JSON (optional)'] || '').trim();\nlet data = original;\nif (edited) { data = JSON.parse(edited.replace(/```json|```/g, '').trim()); }\nconst cfg = $('Config1').first().json;\nconst character = data.character_description || original.character_description || '';\nreturn data.scenes.map((s, i) => ({\n  json: {\n    scene: i + 1,\n    title: data.title,\n    script: s.script,\n    on_screen_text: s.on_screen_text,\n    image_prompt: s.image_prompt + '. Main character: ' + character + '. ' + cfg.style\n  }\n}));"
      },
      "name": "Apply Edits & Split Scenes1",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1808,
        1120
      ],
      "id": "1c0f2a19-f928-45b7-87b2-c45442e2a1ae"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const scene = $('Apply Edits & Split Scenes1').item.json;\nif (!$binary || !$binary.image) throw new Error('No image returned for scene ' + scene.scene);\nreturn { json: scene, binary: { image: $binary.image } };"
      },
      "name": "Extract Image1",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
