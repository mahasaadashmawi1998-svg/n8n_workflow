    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-tts:generateContent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-goog-api-key",
              "value": "={{ $('Config1').first().json.gemini_api_key }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  contents: [{ parts: [{ text: \"Say in a clear, warm narrator voice: \" + $json.script }] }],\n  generationConfig: {\n    responseModalities: [\"AUDIO\"],\n    speechConfig: { voiceConfig: { prebuiltVoiceConfig: { voiceName: $('Config1').first().json.voice } } }\n  }\n}) }}",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 5000
            }
          },
          "timeout": 120000
        }
      },
      "name": "Gemini - Voice (TTS)1",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2032,
        1200
      ],
      "id": "2ea433e2-ba51-406f-b886-8ef89229d159",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 6000
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const parts = $json.candidates[0].content.parts;\nconst p = parts.find(x => x.inlineData || x.inline_data);\nconst scene = $('Apply Edits & Split Scenes1').item.json;\nif (!p) throw new Error('No audio returned for scene ' + scene.scene);\nconst d = p.inlineData || p.inline_data;\nconst pcm = Buffer.from(d.data, 'base64');           // 24 kHz, 16-bit, mono PCM\nconst h = Buffer.alloc(44);\nh.write('RIFF', 0); h.writeUInt32LE(36 + pcm.length, 4); h.write('WAVE', 8);\nh.write('fmt ', 12); h.writeUInt32LE(16, 16); h.writeUInt16LE(1, 20); h.writeUInt16LE(1, 22);\nh.writeUInt32LE(24000, 24); h.writeUInt32LE(48000, 28); h.writeUInt16LE(2, 32); h.writeUInt16LE(16, 34);\nh.write('data', 36); h.writeUInt32LE(pcm.length, 40);\nconst bin = await this.helpers.prepareBinaryData(Buffer.concat([h, pcm]), 'scene_' + scene.scene + '.wav', 'audio/wav');\nreturn { json: scene, binary: { audio: bin } };"
      },
      "name": "Make WAV1",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2256,
        1200
