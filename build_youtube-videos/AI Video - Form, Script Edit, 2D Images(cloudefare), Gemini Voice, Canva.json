    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\nconst data = {};\nfor (const s of d.scenes) {\n  data['scene_' + s.scene + '_image'] = { type: 'image', asset_id: s.image_asset_id };\n  data['scene_' + s.scene + '_text'] = { type: 'text', text: s.caption };\n}\nreturn [{ json: { body: { brand_template_id: $('Config1').first().json.canva_brand_template_id, title: d.title, data } } }];"
