      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.ollamaUrl }}/api/generate",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{\n  {\n    model: \"qwen2.5:3b\",\n    stream: false,\n    format: \"json\",\n    prompt: `You are a professional educational YouTube scriptwriter.\n\nCreate a ${$json.duration_minutes}-minute educational video.\n\nTOPIC: ${$json.topic}\nLANGUAGE: ${$json.language}\n\nRULES:\n- Write approximately 130-150 spoken words per minute.\n- Start with a compelling hook.\n- Explain technical concepts clearly for beginners.\n- Define every technical term the first time it appears.\n- Include one concrete everyday analogy or worked example.\n- Divide the script into 7-10 scenes with short headings.\n- Make narration flow naturally between scenes.\n- Include an introduction, main explanation, example, and recap.\n- Use only facts you are confident about.\n- Do not invent statistics, dates, or specifications.\n- Avoid repetitive explanations and unnecessary filler.\n- Write narration suitable for text-to-speech.\n- Do not include visual instructions inside narration.\n\nOUTPUT:\nReturn valid JSON only, with this structure:\n{\n  \"title\": \"Video title\",\n  \"description\": \"Video description\",\n  \"scenes\": [\n    {\n      \"heading\": \"Scene heading\",\n      \"narration\": \"Spoken narration for this scene\"\n    }\n  ]\n}\n\nDo not include Markdown fences or any text outside the JSON.`\n  }\n}}",
        "options": {
          "timeout": 600000
        }
      },
