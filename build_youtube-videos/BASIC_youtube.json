    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst raw = $input.first().json.response;\nif (!raw) throw new Error('Ollama returned no response');\n\nlet script;\ntry {\n  script = JSON.parse(raw);\n} catch (e) {\n  script = JSON.parse(raw.replace(/```json|```/g, '').trim());\n}\n\nif (!Array.isArray(script.scenes) || script.scenes.length === 0) {\n  throw new Error('No scenes found: ' + raw.slice(0, 300));\n}\n\nconst scenes = script.scenes.map((s, i) => {\n  const narration = String(s.narration ?? '').trim();\n  if (!narration) throw new Error(`Scene ${i + 1} has no narration`);\n  return {\n    id: i + 1,\n    heading: s.heading ?? `Scene ${i + 1}`,\n    narration,\n    visual_query: String(s.visual_query ?? cfg.topic).trim(),\n  };\n});\n\nconst narration = scenes.map(s => s.narration).join('\\n\\n');\nconst wordCount = narration.split(/\\s+/).length;\nconst expectedWords = Number(cfg.duration_minutes) * 140;\n\nreturn [{\n  json: {\n    job_id: cfg.job_id,\n    topic: cfg.topic,\n    title: script.title || cfg.topic,\n    description: script.description || '',\n    scenes,\n    scene_count: scenes.length,\n    narration,\n    word_count: wordCount,\n    too_short: wordCount < expectedWords * 0.6,\n  },\n}];"
      },
