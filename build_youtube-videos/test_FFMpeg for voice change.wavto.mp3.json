      "name": "Cloudflare - Voice (MeloTTS)2",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -48,
        16
      ],
      "id": "615aaf66-1026-48f5-9c23-d446e956e874"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const cfg = $('Test Config').first().json;\nlet buf;\nconst keys = Object.keys($binary || {});\nif (keys.length) {\n  buf = await this.helpers.getBinaryDataBuffer($itemIndex, keys[0]);\n  if (buf.slice(0, 1).toString('latin1') === '{') {\n    const j = JSON.parse(buf.toString('utf8'));\n    const b64 = (j.result && j.result.audio) || j.audio;\n    if (!b64) throw new Error('JSON without audio: ' + buf.toString('utf8').slice(0, 300));\n    buf = Buffer.from(b64, 'base64');\n  }\n} else {\n  const b64 = ($json.result && $json.result.audio) || $json.audio;\n  if (!b64) throw new Error('No audio in JSON or binary. Input: ' + JSON.stringify($json));\n  buf = Buffer.from(b64, 'base64');\n}\nconst ext = buf.slice(0, 4).toString('latin1') === 'RIFF' ? 'wav' : 'mp3';\nconst run = $execution.id;\nconst srcName = 'test_' + run + '_audio_src.' + ext;\nconst bin = await this.helpers.prepareBinaryData(buf, srcName, ext === 'wav' ? 'audio/wav' : 'audio/mpeg');\nreturn { json: {\n  source_format: ext,\n  source_bytes: buf.length,\n  src_path: cfg.base_dir + '/' + srcName,\n  mp3_path: cfg.base_dir + '/test_' + run + '_audio.mp3'\n}, binary: { audio: bin } };"
      },
