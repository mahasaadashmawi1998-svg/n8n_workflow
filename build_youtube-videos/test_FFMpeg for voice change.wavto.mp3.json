    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const m = $('Make Audio File2').item.json;\nconst buf = await this.helpers.getBinaryDataBuffer($itemIndex, 'data');\nconst isMp3 = buf.slice(0, 3).toString('latin1') === 'ID3' || (buf[0] === 0xFF && (buf[1] & 0xE0) === 0xE0);\nreturn { json: {\n  is_mp3: isMp3,\n  source_format: m.source_format,\n  source_bytes: m.source_bytes,\n  mp3_bytes: buf.length,\n  mp3_path: m.mp3_path,\n  message: isMp3 ? 'FFmpeg worked. Play the MP3 file at mp3_path.' : 'The output file is not an MP3. Check the FFmpeg node output.'\n} };"
      },
      "name": "Check Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
