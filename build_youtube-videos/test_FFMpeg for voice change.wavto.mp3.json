    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.cloudflare.com/client/v4/accounts/{{ $('Test Config').first().json.cf_account_id }}/ai/run/@cf/myshell-ai/melotts",
        "sendHeaders": true,
