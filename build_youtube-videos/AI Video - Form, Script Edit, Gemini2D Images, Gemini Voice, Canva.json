      "name": "Canva - Get Upload Job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2720,
        464
      ],
      "id": "3d84a2eb-6833-410e-8e29-03180fb094eb"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.job.status }}",
              "rightValue": "in_progress",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Upload Finished?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        2944,
        464
      ],
      "id": "4919d2ba-4e63-4fcd-829f-4c5d10aef23f"
    },
    {
      "parameters": {
        "jsCode": "const map = {};\nfor (const it of $input.all()) {\n  const job = it.json.job;\n  if (job.status !== 'success') throw new Error('Canva upload failed: ' + JSON.stringify(job.error || job));\n  const m = /scene_(\\d+)_(image|audio)/.exec(job.asset.name);\n  if (!m) continue;\n  const n = parseInt(m[1], 10);\n  map[n] = map[n] || { scene: n };\n  map[n][m[2] + '_asset_id'] = job.asset.id;\n}\nconst info = $('Apply Edits & Split Scenes').all().map(i => i.json);\nconst scenes = Object.values(map).sort((a, b) => a.scene - b.scene).map(s => ({\n  ...s, caption: info[s.scene - 1].on_screen_text, script: info[s.scene - 1].script\n}));\nreturn [{ json: { title: info[0].title, scenes } }];"
      },
      "name": "Collect Canva Assets",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3168,
        464
      ],
      "id": "24456471-575a-4e1e-8258-a29cc96aa38f"
    },
