        "jsonBody": "={{ JSON.stringify({\n  design_type: { type: \"custom\", width: 1080, height: 1920 },\n  asset_id: $json.scenes[0].image_asset_id,\n  title: $json.title\n}) }}",
        "options": {}
      },
      "name": "Canva - Create Design",
