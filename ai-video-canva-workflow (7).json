        600
      ],
      "id": "canva---autofill-template-(enterprise)",
      "disabled": true,
      "credentials": {
        "oAuth2Api": {
          "id": "canva-oauth2",
          "name": "Canva OAuth2 API"
        }
      }
    },
    {
