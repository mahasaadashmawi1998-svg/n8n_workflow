        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/octet-stream"
            },
            {
              "name": "Asset-Upload-Metadata",
              "value": "={{ JSON.stringify({ name_base64: $json.name_base64 }) }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "binaryData",
        "inputDataFieldName": "data",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 2500
            }
          }
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api"
      },
      "name": "Canva - Upload Asset",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1980,
        380
      ],
      "id": "canva---upload-asset",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "oAuth2Api": {
          "id": "canva-oauth2",
          "name": "Canva OAuth2 API"
        }
      }
    },
    {
      "parameters": {
        "amount": 3,
        "unit": "seconds"
      },
      "name": "Wait 3s",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        2200,
        380
      ],
      "id": "wait-3s",
      "webhookId": "50563571-1538-40f2-b198-3ff3f28bd768"
    },
    {
      "parameters": {
        "method": "GET",
        "url": "=https://api.canva.com/rest/v1/asset-uploads/{{ $json.job.id }}",
        "sendHeaders": false,
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api"
      },
      "name": "Canva - Get Upload Job",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2420,
        380
      ],
      "id": "canva---get-upload-job",
      "credentials": {
        "oAuth2Api": {
          "id": "canva-oauth2",
          "name": "Canva OAuth2 API"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.job.status }}",
              "rightValue": "in_progress",
              "operator": {
                "type": "string",
                "operation": "notEquals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Upload Finished?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        2640,
        380
      ],
      "id": "upload-finished?"
    },
    {
      "parameters": {
        "jsCode": "const map = {};\nfor (const it of $input.all()) {\n  const job = it.json.job;\n  if (job.status !== 'success') throw new Error('Canva upload failed: ' + JSON.stringify(job.error || job));\n  const m = /scene_(\\d+)_(image|audio)/.exec(job.asset.name);\n  if (!m) continue;\n  const n = parseInt(m[1], 10);\n  map[n] = map[n] || { scene: n };\n  map[n][m[2] + '_asset_id'] = job.asset.id;\n}\nconst info = $('Apply Edits & Split Scenes').all().map(i => i.json);\nconst scenes = Object.values(map).sort((a, b) => a.scene - b.scene).map(s => ({\n  ...s, caption: info[s.scene - 1].on_screen_text, script: info[s.scene - 1].script\n}));\nreturn [{ json: { title: info[0].title, scenes } }];"
      },
      "name": "Collect Canva Assets",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2860,
        380
      ],
      "id": "collect-canva-assets"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.canva.com/rest/v1/designs",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  design_type: { type: \"custom\", width: 1080, height: 1920 },\n  asset_id: $json.scenes[0].image_asset_id,\n  title: $json.title\n}) }}",
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api"
      },
      "name": "Canva - Create Design",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        3080,
        380
      ],
      "id": "canva---create-design",
      "credentials": {
        "oAuth2Api": {
          "id": "canva-oauth2",
          "name": "Canva OAuth2 API"
        }
      }
    },
    {
      "parameters": {
        "operation": "completion",
        "completionTitle": "Your Canva design is ready",
        "completionMessage": "={{ 'Open your design: ' + $json.design.urls.edit_url + ' | Every scene image and voice file is in your Canva Uploads as scene_01_image, scene_01_audio, and so on. Drag each voice file onto its page.' }}",
        "options": {}
      },
      "name": "Done - Show Canva Link",
      "type": "n8n-nodes-base.form",
      "typeVersion": 2.3,
      "position": [
        3300,
        380
      ],
      "id": "done---show-canva-link",
      "webhookId": "bfb14c4e-7d28-48fe-bea1-7714dbdf3159"
    },
    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\nconst data = {};\nfor (const s of d.scenes) {\n  data['scene_' + s.scene + '_image'] = { type: 'image', asset_id: s.image_asset_id };\n  data['scene_' + s.scene + '_text'] = { type: 'text', text: s.caption };\n}\nreturn [{ json: { body: { brand_template_id: $('Config').first().json.canva_brand_template_id, title: d.title, data } } }];"
      },
      "name": "Build Autofill Data (Enterprise)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3080,
        600
      ],
      "id": "build-autofill-data-(enterprise)",
      "disabled": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.canva.com/rest/v1/autofills",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body) }}",
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api"
      },
      "name": "Canva - Autofill Template (Enterprise)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
