    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash:generateContent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-goog-api-key",
              "value": "={{ $('Config').first().json.gemini_api_key }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  contents: [{ parts: [{ text: [\n    'You are a short-form video scriptwriter. Write an English narration script about: ' + $json.topic + '.',\n    'Tone: ' + $json.tone + '. Use exactly ' + $json.scene_count + ' scenes, about 40 seconds in total.',\n    'Rules:',\n    '- Scene 1 is the hook: a surprising fact, bold claim or question in under 12 words. Never start with \"Today\" or \"In this video\".',\n    '- Each scene is 1-2 short sentences, 12-22 words, written to be spoken aloud in plain conversational words.',\n    '- One idea per scene, and each scene makes the viewer curious about the next one.',\n    '- The last scene gives a memorable takeaway and a short call to action such as follow for more.',\n    '- No filler, no jargon, and no facts you are not sure about.',\n    '- on_screen_text: max 5 punchy words that add to the narration, not a copy of it.',\n    '- image_prompt: one clear visual with subject, action, setting and mood, matching character_description, with no text in the image.',\n    'Return JSON only in this shape: {\"title\": \"catchy title\", \"character_description\": \"one sentence describing the main character or visual motif for consistent images\", \"scenes\": [{\"script\": \"narration\", \"image_prompt\": \"visual description\", \"on_screen_text\": \"short caption\"}]}'\n  ].join('\\n') }] }],\n  generationConfig: { responseMimeType: \"application/json\" }\n}) }}",
        "options": {}
      },
      "name": "Gemini - Write Script",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        200
      ],
      "id": "gemini---write-script",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.candidates[0].content.parts[0].text;\nconst data = JSON.parse(raw.replace(/```json|```/g, '').trim());\nconst esc = s => String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nlet totalWords = 0;\nconst readable = data.scenes.map((s, i) => {\n  const words = String(s.script).trim().split(/\\s+/).length;\n  totalWords += words;\n  return '<p><b>Scene ' + (i + 1) + '</b> (' + words + ' words, about ' + Math.round(words / 2.5) + 's)<br>' + esc(s.script) + '<br><i>Caption: ' + esc(s.on_screen_text) + '</i></p>';\n}).join('');\nconst pretty = JSON.stringify(data, null, 2);\nconst html = '<h3>' + esc(data.title) + '</h3>' + readable +\n  '<p><b>Total:</b> ' + totalWords + ' words, about ' + Math.round(totalWords / 2.5) + ' seconds. Check: strong hook in scene 1, one idea per scene, clear ending.</p>' +\n  '<p>To change anything, copy the JSON below, edit it, and paste it into the box. Leave the box empty to approve it as is.</p>' +\n  '<pre style=\"white-space:pre-wrap;text-align:left\">' + esc(pretty) + '</pre>';\nreturn [{ json: { data, html } }];"
      },
      "name": "Format Script for Edit",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        200
      ],
      "id": "format-script-for-edit"
    },
    {
      "parameters": {
        "defineForm": "fields",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Edited script JSON (optional)",
              "fieldType": "textarea",
              "placeholder": "Paste edited JSON here, or leave empty to approve"
            }
          ]
        },
        "options": {
          "formTitle": "Review your script",
          "formDescription": "={{ $json.html }}",
          "buttonLabel": "Approve & generate scenes"
        }
      },
      "name": "Review & Edit Script",
      "type": "n8n-nodes-base.form",
      "typeVersion": 2.3,
      "position": [
        880,
        200
      ],
      "id": "review-and-edit-script",
      "webhookId": "e1c5625a-8457-4fc2-b21d-9449888427f2"
    },
    {
      "parameters": {
        "jsCode": "const original = $('Format Script for Edit').first().json.data;\nconst edited = String($json['Edited script JSON (optional)'] || '').trim();\nlet data = original;\nif (edited) { data = JSON.parse(edited.replace(/```json|```/g, '').trim()); }\nconst cfg = $('Config').first().json;\nconst character = data.character_description || original.character_description || '';\nreturn data.scenes.map((s, i) => ({\n  json: {\n    scene: i + 1,\n    title: data.title,\n    script: s.script,\n    on_screen_text: s.on_screen_text,\n    image_prompt: s.image_prompt + '. Main character: ' + character + '. ' + cfg.style\n  }\n}));"
      },
      "name": "Apply Edits & Split Scenes",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        200
      ],
      "id": "apply-edits-and-split-scenes"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.cloudflare.com/client/v4/accounts/{{ $('Config').first().json.cf_account_id }}/ai/run/@cf/black-forest-labs/flux-1-schnell",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $('Config').first().json.cf_api_token }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ prompt: String($json.image_prompt).slice(0, 2000), steps: 4, seed: $json.scene * 7 }) }}",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 2000
            }
          },
          "timeout": 120000
        }
      },
      "name": "Cloudflare - 2D Illustration",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1540,
        80
      ],
      "id": "cloudflare-2d-illustration",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const scene = $('Loop Over Scenes').item.json;\nconst b64 = $json.result && $json.result.image;\nif (!b64) throw new Error('No image returned for scene ' + scene.scene + ': ' + JSON.stringify($json.errors || $json));\nconst bin = await this.helpers.prepareBinaryData(Buffer.from(b64, 'base64'), 'scene_' + scene.scene + '.jpg', 'image/jpeg');\nreturn { json: scene, binary: { image: bin } };"
      },
      "name": "Extract Image",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        80
      ],
      "id": "extract-image"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.5-flash-preview-tts:generateContent",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-goog-api-key",
              "value": "={{ $('Config').first().json.gemini_api_key }}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  contents: [{ parts: [{ text: \"Say in a clear, warm narrator voice: \" + $json.script }] }],\n  generationConfig: {\n    responseModalities: [\"AUDIO\"],\n    speechConfig: { voiceConfig: { prebuiltVoiceConfig: { voiceName: $('Config').first().json.voice } } }\n  }\n}) }}",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 1,
              "batchInterval": 5000
            }
          },
          "timeout": 120000
        }
      },
      "name": "Gemini - Voice (TTS)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1980,
        80
      ],
      "id": "gemini---voice-(tts)",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 6000
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const ex = $('Extract Image').item;\nconst scene = ex.json;\nconst parts = $json.candidates[0].content.parts;\nconst p = parts.find(x => x.inlineData || x.inline_data);\nif (!p) throw new Error('No audio returned for scene ' + scene.scene);\nconst d = p.inlineData || p.inline_data;\nconst pcm = Buffer.from(d.data, 'base64');           // 24 kHz, 16-bit, mono PCM\nconst h = Buffer.alloc(44);\nh.write('RIFF', 0); h.writeUInt32LE(36 + pcm.length, 4); h.write('WAVE', 8);\nh.write('fmt ', 12); h.writeUInt32LE(16, 16); h.writeUInt16LE(1, 20); h.writeUInt16LE(1, 22);\nh.writeUInt32LE(24000, 24); h.writeUInt32LE(48000, 28); h.writeUInt16LE(2, 32); h.writeUInt16LE(16, 34);\nh.write('data', 36); h.writeUInt32LE(pcm.length, 40);\nconst bin = await this.helpers.prepareBinaryData(Buffer.concat([h, pcm]), 'scene_' + scene.scene + '.wav', 'audio/wav');\nreturn { json: scene, binary: { image: ex.binary.image, audio: bin } };"
      },
      "name": "Make WAV",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        80
      ],
      "id": "make-wav"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst out = [];\nfor (const it of items) {\n  const n = String(it.json.scene).padStart(2, '0');\n  for (const kind of ['image', 'audio']) {\n    const name = 'scene_' + n + '_' + kind;\n    out.push({\n      json: { scene: it.json.scene, kind, asset_name: name, name_base64: Buffer.from(name).toString('base64') },\n      binary: { data: it.binary[kind] }\n    });\n  }\n}\nreturn out;"
      },
      "name": "Prepare Files for Canva",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        380
      ],
      "id": "prepare-files-for-canva"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.canva.com/rest/v1/asset-uploads",
